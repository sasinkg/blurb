rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profile-images/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /post-images/{groupID}/{userID}/{fileName} {
      allow delete: if request.auth != null && (
        request.auth.uid == userID
        || firestore.get(
          /databases/(default)/documents/groups/$(groupID)
        ).data.ownerID == request.auth.uid
      );
      allow read: if request.auth != null
        && firestore.get(
          /databases/(default)/documents/groups/$(groupID)
        ).data.memberIDs.hasAny([request.auth.uid]);
      allow write: if request.auth != null
        && request.auth.uid == userID
        && firestore.get(
          /databases/(default)/documents/groups/$(groupID)
        ).data.memberIDs.hasAny([request.auth.uid])
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /photo-of-month/{groupID}/{userID}/{monthKey}/{fileName} {
      // Private until the monthly newsletter copies the selected image URL.
      allow read, delete: if request.auth != null && request.auth.uid == userID;
      allow create: if request.auth != null
        && request.auth.uid == userID
        && firestore.get(
          /databases/(default)/documents/groups/$(groupID)
        ).data.memberIDs.hasAny([request.auth.uid])
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update: if false;
    }
  }
}
