rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupID) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupID))
        && (
          get(/databases/$(database)/documents/groups/$(groupID)).data.ownerID == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupID)).data.memberIDs.hasAny([request.auth.uid])
        );
    }

    function isGroupOwner(groupID) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupID)).data.ownerID == request.auth.uid;
    }

    match /users/{userID} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userID;
    }

    match /groups/{groupID} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIDs;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerID
        && request.resource.data.memberIDs.size() == 1
        && request.auth.uid in request.resource.data.memberIDs;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerID
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIDs'])
          && !(request.auth.uid in resource.data.memberIDs)
          && request.auth.uid in request.resource.data.memberIDs
          && request.resource.data.memberIDs.hasAll(resource.data.memberIDs)
          && request.resource.data.memberIDs.size() == resource.data.memberIDs.size() + 1
          && exists(/databases/$(database)/documents/groupInvites/$(resource.data.inviteCode))
          && get(/databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)).data.groupID == groupID
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIDs'])
          && request.auth.uid in resource.data.memberIDs
          && !(request.auth.uid in request.resource.data.memberIDs)
          && resource.data.memberIDs.hasAll(request.resource.data.memberIDs)
          && request.resource.data.memberIDs.size() == resource.data.memberIDs.size() - 1
        )
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerID;
    }

    match /groupInvites/{inviteCode} {
      // Codes are unguessable document IDs. They can be fetched directly but
      // never listed or searched, so group metadata remains private.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerID == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.ownerID == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.inviteCode == inviteCode;
      allow update: if signedIn()
        && resource.data.ownerID == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerID']);
      allow delete: if signedIn()
        && resource.data.ownerID == request.auth.uid;
    }

    match /posts/{postID} {
      allow read: if isGroupMember(resource.data.groupID);
      allow create: if isGroupMember(request.resource.data.groupID)
        && request.auth.uid == request.resource.data.authorID
        && request.auth.uid in request.resource.data.viewerIDs;
      allow update: if isGroupMember(resource.data.groupID)
        && request.resource.data.groupID == resource.data.groupID
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeIDs'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          )
          || (
            request.auth.uid == resource.data.authorID
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['authorName', 'authorPhotoURL'])
          )
          || (
            request.auth.uid == resource.data.authorID
            && resource.data.editCount == 0
            && request.resource.data.editCount == 1
            && request.resource.data.countsTowardStreak == false
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'editedAt', 'editCount', 'countsTowardStreak'])
          )
        );
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.authorID
        || isGroupOwner(resource.data.groupID)
      );

      match /comments/{commentID} {
        allow read: if isGroupMember(
          get(/databases/$(database)/documents/posts/$(postID)).data.groupID
        );
        allow create: if isGroupMember(
            get(/databases/$(database)/documents/posts/$(postID)).data.groupID
          )
          && request.resource.data.authorID == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if signedIn() && (
          request.auth.uid == resource.data.authorID
          || isGroupOwner(
            get(/databases/$(database)/documents/posts/$(postID)).data.groupID
          )
        );
      }
    }
  }
}
