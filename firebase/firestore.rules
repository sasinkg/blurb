rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupID) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupID))
        && (
          get(/databases/$(database)/documents/groups/$(groupID)).data.ownerID == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupID)).data.memberIDs.hasAny([request.auth.uid])
        );
    }

    function isGroupOwner(groupID) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupID)).data.ownerID == request.auth.uid;
    }

    function hasValidCityLocation(data) {
      return !('cityLocation' in data) || (
        data.cityLocation is map
        && data.cityLocation.keys().hasOnly(['city', 'region', 'countryCode'])
        && data.cityLocation.city is string
        && data.cityLocation.city.size() > 0
        && data.cityLocation.city.size() <= 100
        && (!('region' in data.cityLocation) || (
          data.cityLocation.region is string && data.cityLocation.region.size() <= 100
        ))
        && (!('countryCode' in data.cityLocation) || (
          data.cityLocation.countryCode is string && data.cityLocation.countryCode.size() <= 3
        ))
      );
    }

    match /users/{userID} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userID;

      match /photoOfMonthSelections/{selectionID} {
        // Selections remain private until a trusted monthly recap copies them
        // into a published edition. All mutations go through the callable
        // function so membership, ownership, month, and lock rules are enforced.
        allow read: if signedIn() && request.auth.uid == userID;
        allow write: if false;
      }

      match /blockedUsers/{blockedUserID} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userID
          && blockedUserID != request.auth.uid;
      }
    }

    match /groups/{groupID} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIDs;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerID
        && request.resource.data.memberIDs.size() == 1
        && request.auth.uid in request.resource.data.memberIDs;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerID
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIDs'])
          && !(request.auth.uid in resource.data.memberIDs)
          && request.auth.uid in request.resource.data.memberIDs
          && request.resource.data.memberIDs.hasAll(resource.data.memberIDs)
          && request.resource.data.memberIDs.size() == resource.data.memberIDs.size() + 1
          && exists(/databases/$(database)/documents/groupInvites/$(resource.data.inviteCode))
          && get(/databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)).data.groupID == groupID
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIDs'])
          && request.auth.uid in resource.data.memberIDs
          && !(request.auth.uid in request.resource.data.memberIDs)
          && resource.data.memberIDs.hasAll(request.resource.data.memberIDs)
          && request.resource.data.memberIDs.size() == resource.data.memberIDs.size() - 1
        )
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerID;
    }

    match /groupInvites/{inviteCode} {
      // Codes are unguessable document IDs. They can be fetched directly but
      // never listed or searched, so group metadata remains private.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerID == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.ownerID == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.inviteCode == inviteCode;
      allow update: if signedIn()
        && resource.data.ownerID == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerID']);
      allow delete: if signedIn()
        && resource.data.ownerID == request.auth.uid;
    }

    match /posts/{postID} {
      allow read: if isGroupMember(resource.data.groupID);
      allow create: if isGroupMember(request.resource.data.groupID)
        && request.auth.uid == request.resource.data.authorID
        && request.auth.uid in request.resource.data.viewerIDs
        && hasValidCityLocation(request.resource.data);
      allow update: if isGroupMember(resource.data.groupID)
        && request.resource.data.groupID == resource.data.groupID
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeIDs'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && request.resource.data.commentCount is int
            && request.resource.data.commentCount >= 0
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1)
          )
          || (
            request.auth.uid == resource.data.authorID
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['authorName', 'authorPhotoURL'])
          )
          || (
            request.auth.uid == resource.data.authorID
            && request.resource.data.editCount == resource.data.get('editCount', 0) + 1
            && request.resource.data.countsTowardStreak == false
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'imageURL', 'editedAt', 'editCount', 'countsTowardStreak'])
          )
        );
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.authorID
        || isGroupOwner(resource.data.groupID)
      );

      match /comments/{commentID} {
        allow read: if isGroupMember(
          get(/databases/$(database)/documents/posts/$(postID)).data.groupID
        );
        allow create: if isGroupMember(
            get(/databases/$(database)/documents/posts/$(postID)).data.groupID
          )
          && request.resource.data.authorID == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.get('likeIDs', []) is list
          && request.resource.data.get('likeIDs', []).size() == 0;
        allow update: if isGroupMember(
            get(/databases/$(database)/documents/posts/$(postID)).data.groupID
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeIDs'])
          && request.resource.data.likeIDs is list
          && request.resource.data.likeIDs.size() == request.resource.data.likeIDs.toSet().size()
          && request.resource.data.likeIDs.toSet().difference(resource.data.get('likeIDs', []).toSet()).hasOnly([request.auth.uid])
          && resource.data.get('likeIDs', []).toSet().difference(request.resource.data.likeIDs.toSet()).hasOnly([request.auth.uid]);
        allow update: if isGroupMember(
            get(/databases/$(database)/documents/posts/$(postID)).data.groupID
          )
          && request.auth.uid == resource.data.authorID
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.editedAt == request.time;
        allow delete: if signedIn() && (
          request.auth.uid == resource.data.authorID
          || isGroupOwner(
            get(/databases/$(database)/documents/posts/$(postID)).data.groupID
          )
        );
      }
    }

    match /newsletterEditions/{editionID} {
      allow read: if signedIn() && request.auth.uid in resource.data.viewerIDs;
      allow write: if false;
    }

    match /reports/{reportID} {
      // Reports are write-only for clients. Review and status changes happen
      // through the Firebase console or trusted server tooling.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterID', 'reportedUserID', 'groupID', 'targetType',
          'postID', 'commentID', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.reporterID == request.auth.uid
        && request.resource.data.reportedUserID is string
        && request.resource.data.reportedUserID != request.auth.uid
        && request.resource.data.groupID is string
        && isGroupMember(request.resource.data.groupID)
        && request.resource.data.targetType in ['post', 'reply']
        && request.resource.data.postID is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postID))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postID)).data.groupID
          == request.resource.data.groupID
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 100
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.targetType == 'post'
          || request.resource.data.commentID is string);
      allow read, update, delete: if false;
    }
  }
}
