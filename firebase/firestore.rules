rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupID) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupID)).data.memberIDs;
    }

    match /users/{userID} {
      allow read, create, update: if signedIn() && request.auth.uid == userID;
    }

    match /groups/{groupID} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIDs;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerID
        && request.resource.data.memberIDs.size() == 1
        && request.auth.uid in request.resource.data.memberIDs;
      allow update: if signedIn() && request.auth.uid == resource.data.ownerID;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerID;
    }

    match /posts/{postID} {
      allow read: if isGroupMember(resource.data.groupID);
      allow create: if isGroupMember(request.resource.data.groupID)
        && request.auth.uid == request.resource.data.authorID;
      allow update: if isGroupMember(resource.data.groupID)
        && request.resource.data.groupID == resource.data.groupID
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeIDs'])
          || (
            request.auth.uid == resource.data.authorID
            && resource.data.editCount == 0
            && request.resource.data.editCount == 1
            && request.resource.data.countsTowardStreak == false
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'editedAt', 'editCount', 'countsTowardStreak'])
          )
        );
      allow delete: if signedIn() && request.auth.uid == resource.data.authorID;
    }
  }
}
